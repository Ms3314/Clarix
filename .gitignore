# Standard Python gitignore patterns
__pycache__/
*.py[cod]
*$py.class
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
*.db
*.sqlite3
.vscode/
.idea/
node_modules/
dist/
build/
.claude
chroma_db/
uploads/

# OS junk
.DS_Store

# Evals: local vector indexes and copyrighted source text (rebuild with evals/build_corpus.py)
evals/.index/
evals/corpus/*.pdf
evals/corpus/pages.json
evals/corpus/chapters/
evals/.judge_cache/

# Generated tutor answers embed copyrighted book chunks
evals/results/answers_*.jsonl
