SECRET_KEY=your-secret-key-here
DATABASE_URL=sqlite:///./todosapp.db

# Supabase (for file storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-key

# RAG — LLM
OPENAI_API_KEY=sk-your-openai-api-key

# RAG — Vector store
CHROMA_API_KEY=your-chroma-api-key
CHROMA_TENANT=your-chroma-tenant
CHROMA_DATABASE=your-chroma-database

# Provider switch (see backend/llm.py). Defaults are Ollama for local dev.
# LLM_PROVIDER=ollama            # or openai (any OpenAI-compatible API, e.g. OpenRouter)
# LLM_MODEL=qwen3.5:latest
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=
# EMBEDDING_PROVIDER=ollama      # or openai
# EMBEDDING_MODEL=nomic-embed-text-v2-moe:latest
# CORS_ORIGINS=                  # comma-separated allow-list; unset = reflect any origin (dev)
# COOKIE_SECURE=false
