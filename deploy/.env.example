# Copy to the repo root as .env on the server:  cp deploy/.env.example .env
# Never commit the real file (.env is gitignored).

# ---- Site ----
DOMAIN=clarix.example.com
# Memory cap for the backend container (e.g. 700m on a 1 GB box, 2g on Ampere)
BACKEND_MEM_LIMIT=700m

# ---- Auth ----
# Generate with: openssl rand -hex 32
SECRET_KEY=

# ---- Database ----
# Supabase Postgres (Project Settings -> Database -> Session pooler, port 5432):
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# or SQLite on the server's volume:
# DATABASE_URL=sqlite:////app/data/clarix.db

# ---- Supabase Storage ----
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_KEY=

# ---- Chroma Cloud ----
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=

# ---- LLM (OpenRouter, OpenAI-compatible) ----
LLM_PROVIDER=openai
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-4o-mini

# ---- Embeddings (OpenAI) ----
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=
