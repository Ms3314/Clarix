# DOMAIN comes from the environment (docker-compose passes it in).
# Caddy gets and renews the Let's Encrypt certificate on its own as long as
# DNS points at this machine and ports 80 and 443 are open.
{$DOMAIN} {
	encode zstd gzip

	# API: strip the /api prefix and forward to FastAPI.
	handle_path /api/* {
		request_body {
			max_size 25MB
		}
		reverse_proxy backend:8000 {
			# PDF indexing and LLM calls run inside the request and can be slow.
			transport http {
				read_timeout 300s
				write_timeout 300s
			}
		}
	}

	# SPA: serve files, fall back to index.html for client-side routes.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output stdout
		format console
	}
}
